   }
 };
 
+/// The <math.h> function `calleeStr` for `type`: `std::` qualified for C++,
+/// and with the `f` suffix of the float variant for an f32 in C.
+std::string getCalleeName(StringRef calleeStr, Type type,
+                          emitc::LanguageTarget languageTarget) {
+  if (languageTarget == emitc::LanguageTarget::cpp11)
+    return ("std::" + calleeStr).str();
+  if (type.isF32())
+    return (calleeStr + "f").str();
+  return calleeStr.str();
+}
+
 template <typename OpType>
 class LowerToEmitCCallOpaque : public OpRewritePattern<OpType> {
   std::string calleeStr;
@@ -57,19 +68,72 @@ LogicalResult LowerToEmitCCallOpaque<OpType>::matchAndRewrite(
     return rewriter.notifyMatchFailure(
         op.getLoc(),
         "expected all operands and results to be of type f32 or f64");
-  std::string modifiedCalleeStr = calleeStr;
-  if (languageTarget == emitc::LanguageTarget::cpp11) {
-    modifiedCalleeStr = "std::" + calleeStr;
-  } else if (languageTarget == emitc::LanguageTarget::c99) {
-    auto operandType = op->getOperandTypes()[0];
-    if (operandType.isF32())
-      modifiedCalleeStr = calleeStr + "f";
-  }
   rewriter.replaceOpWithNewOp<emitc::CallOpaqueOp>(
-      op, op.getType(), modifiedCalleeStr, op->getOperands());
+      op, op.getType(),
+      getCalleeName(calleeStr, op->getOperandTypes()[0], languageTarget),
+      op->getOperands());
   return success();
 }
 
+/// Lowers a floating-point classification op (`math.isnan` etc.) to a call of
+/// the <math.h> macro of the same name, which takes any floating-point type
+/// and so needs no type suffix in C.
+template <typename OpType>
+class LowerClassificationToEmitCCallOpaque : public OpRewritePattern<OpType> {
+  std::string calleeStr;
+  emitc::LanguageTarget languageTarget;
+
+public:
+  LowerClassificationToEmitCCallOpaque(MLIRContext *context,
+                                       std::string calleeStr,
+                                       emitc::LanguageTarget languageTarget)
+      : OpRewritePattern<OpType>(context), calleeStr(std::move(calleeStr)),
+        languageTarget(languageTarget) {}
+
+  LogicalResult matchAndRewrite(OpType op,
+                                PatternRewriter &rewriter) const override {
+    if (!isa<Float32Type, Float64Type>(op.getOperand().getType()) ||
+        !op.getType().isInteger(1))
+      return rewriter.notifyMatchFailure(
+          op.getLoc(), "expected an f32 or f64 operand and an i1 result");
+    std::string callee = languageTarget == emitc::LanguageTarget::cpp11
+                             ? "std::" + calleeStr
+                             : calleeStr;
+    rewriter.replaceOpWithNewOp<emitc::CallOpaqueOp>(op, op.getType(), callee,
+                                                     op.getOperand());
+    return success();
+  }
+};
+
+/// Lowers `math.sincos` to separate `sin` and `cos` calls.
+class LowerSincosToEmitCCallOpaque : public OpRewritePattern<math::SincosOp> {
+  emitc::LanguageTarget languageTarget;
+
+public:
+  LowerSincosToEmitCCallOpaque(MLIRContext *context,
+                               emitc::LanguageTarget languageTarget)
+      : OpRewritePattern<math::SincosOp>(context),
+        languageTarget(languageTarget) {}
+
+  LogicalResult matchAndRewrite(math::SincosOp op,
+                                PatternRewriter &rewriter) const override {
+    Type type = op.getOperand().getType();
+    if (!isa<Float32Type, Float64Type>(type))
+      return rewriter.notifyMatchFailure(
+          op.getLoc(), "expected the operand to be of type f32 or f64");
+    Value sin = emitc::CallOpaqueOp::create(
+                    rewriter, op.getLoc(), type,
+                    getCalleeName("sin", type, languageTarget), op.getOperand())
+                    .getResult(0);
+    Value cos = emitc::CallOpaqueOp::create(
+                    rewriter, op.getLoc(), type,
+                    getCalleeName("cos", type, languageTarget), op.getOperand())
+                    .getResult(0);
+    rewriter.replaceOp(op, {sin, cos});
+    return success();
+  }
+};
+
 } // namespace
 
