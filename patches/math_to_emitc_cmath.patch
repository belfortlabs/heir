+    // cpp11-NEXT: emitc.call_opaque "std::isnormal"(%{{.*}}) : (f64) -> i1
+    %0 = math.isnormal %arg0 : f32
+    %1 = math.isnormal %arg1 : f64
+    return
+}
+
+func.func @sincos(%arg0: f32, %arg1: f64) {
+    // c99: emitc.call_opaque "sinf"
+    // c99-NEXT: emitc.call_opaque "cosf"
+    // c99-NEXT: emitc.call_opaque "sin"
+    // c99-NEXT: emitc.call_opaque "cos"
+    // cpp11: emitc.call_opaque "std::sin"
+    // cpp11-NEXT: emitc.call_opaque "std::cos"
+    // cpp11-NEXT: emitc.call_opaque "std::sin"
+    // cpp11-NEXT: emitc.call_opaque "std::cos"
+    %0, %1 = math.sincos %arg0 : f32
+    %2, %3 = math.sincos %arg1 : f64
+    return
+}
-- 
2.52.0


From db907a563d858bb663280bd5104164d6f8a1b9a8 Mon Sep 17 00:00:00 2001
From: Alexander Viand <alexander.viand@gmail.com>
Date: Sat, 3 Oct 2026 00:23:29 +0200
Subject: [PATCH 2/2] [mlir][emitc] Lower math.roundeven to std::nearbyint for
 C++

C++ has no std::roundeven: roundeven is a C23 addition that <cmath> does
not provide, so the emitted call did not compile. std::nearbyint rounds
half to even in the default rounding mode, which is what math.roundeven
specifies. The C target keeps calling roundeven.
---
 mlir/lib/Conversion/MathToEmitC/MathToEmitC.cpp     | 7 ++++++-
 mlir/test/Conversion/MathToEmitC/math-to-emitc.mlir | 4 ++--
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/mlir/lib/Conversion/MathToEmitC/MathToEmitC.cpp b/mlir/lib/Conversion/MathToEmitC/MathToEmitC.cpp
index fc1a4b5ab21d..955d8e061810 100644
--- a/mlir/lib/Conversion/MathToEmitC/MathToEmitC.cpp
+++ b/mlir/lib/Conversion/MathToEmitC/MathToEmitC.cpp
@@ -151,8 +151,13 @@ void mlir::populateConvertMathToEmitCPatterns(
                                                          languageTarget);
   patterns.insert<LowerToEmitCCallOpaque<math::RoundOp>>(context, "round",
                                                          languageTarget);
+  // C++ has no `roundeven`; `nearbyint` rounds half to even in the default
+  // rounding mode.
   patterns.insert<LowerToEmitCCallOpaque<math::RoundEvenOp>>(
-      context, "roundeven", languageTarget);
+      context,
+      languageTarget == emitc::LanguageTarget::cpp11 ? "nearbyint"
+                                                     : "roundeven",
+      languageTarget);
   patterns.insert<LowerToEmitCCallOpaque<math::ExpOp>>(context, "exp",
                                                        languageTarget);
   patterns.insert<LowerToEmitCCallOpaque<math::CosOp>>(context, "cos",
diff --git a/mlir/test/Conversion/MathToEmitC/math-to-emitc.mlir b/mlir/test/Conversion/MathToEmitC/math-to-emitc.mlir
index 6f8acfdb6435..b5540171c15e 100644
--- a/mlir/test/Conversion/MathToEmitC/math-to-emitc.mlir
+++ b/mlir/test/Conversion/MathToEmitC/math-to-emitc.mlir
@@ -126,8 +126,8 @@ func.func @round(%arg0: f32, %arg1: f64) {
 func.func @roundeven(%arg0: f32, %arg1: f64) {
   // c99: emitc.call_opaque "roundevenf"
   // c99-NEXT: emitc.call_opaque "roundeven"
-  // cpp11: emitc.call_opaque "std::roundeven"
-  // cpp11-NEXT: emitc.call_opaque "std::roundeven"
+  // cpp11: emitc.call_opaque "std::nearbyint"
+  // cpp11-NEXT: emitc.call_opaque "std::nearbyint"
   %0 = math.roundeven %arg0 : f32
   %1 = math.roundeven %arg1 : f64
   return
-- 
